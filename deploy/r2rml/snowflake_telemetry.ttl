# R2RML mapping generated by r2g (source: snowflake).
# Relational -> RDF for SPARQL->SQL pushdown (e.g. Ontop). No data movement.
# Concept IRIs: <urn:arango-sparql:concept#...>   Resource IRIs: <http://r2g.example/resource/...>

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#UsageMetric>
    a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "USAGE_METRICS" ] ;
    rr:subjectMap [
        rr:template "http://r2g.example/resource/UsageMetric/{ID}/{ACCOUNT_ID}/{CLUSTER_NODES}/{CONTRACTED_SEATS_MIRROR}/{EDITION}/{GRAPHRAG_ENABLED}/{IS_PEAK_PERIOD}/{PERIOD}/{QUERIES_PER_NODE_M}/{QUERY_VOLUME_GROWTH_PCT}/{QUERY_VOLUME_M}/{SEATS_ACTIVE}/{SMARTGRAPHS_ENABLED}/{VOLUME_TREND}" ;
        rr:class <urn:arango-sparql:concept#UsageMetric> ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#id> ;
        rr:objectMap [ rr:column "ID" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#accountId> ;
        rr:objectMap [ rr:column "ACCOUNT_ID" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#clusterNodes> ;
        rr:objectMap [ rr:column "CLUSTER_NODES" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#contractedSeatsMirror> ;
        rr:objectMap [ rr:column "CONTRACTED_SEATS_MIRROR" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#edition> ;
        rr:objectMap [ rr:column "EDITION" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#graphragEnabled> ;
        rr:objectMap [ rr:column "GRAPHRAG_ENABLED" ; rr:datatype xsd:boolean ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#isPeakPeriod> ;
        rr:objectMap [ rr:column "IS_PEAK_PERIOD" ; rr:datatype xsd:boolean ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#period> ;
        rr:objectMap [ rr:column "PERIOD" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#queriesPerNodeM> ;
        rr:objectMap [ rr:column "QUERIES_PER_NODE_M" ; rr:datatype xsd:double ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#queryVolumeGrowthPct> ;
        rr:objectMap [ rr:column "QUERY_VOLUME_GROWTH_PCT" ; rr:datatype xsd:double ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#queryVolumeM> ;
        rr:objectMap [ rr:column "QUERY_VOLUME_M" ; rr:datatype xsd:double ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#seatsActive> ;
        rr:objectMap [ rr:column "SEATS_ACTIVE" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#smartgraphsEnabled> ;
        rr:objectMap [ rr:column "SMARTGRAPHS_ENABLED" ; rr:datatype xsd:boolean ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#volumeTrend> ;
        rr:objectMap [ rr:column "VOLUME_TREND" ] ;
    ] .
# NOTE: 'USAGE_METRICS' has no primary key; subject template uses all columns

